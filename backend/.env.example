# ── Chain RPC (single chain: 0G Galileo 16602) ────────────────────────────────
ZG_RPC_URL=https://evmrpc-testnet.0g.ai

# ── Wallet (NEVER commit) ─────────────────────────────────────────────────────
OPERATOR_PRIVATE_KEY=0x...

# ── 0G contracts ──────────────────────────────────────────────────────────────
WALL_AGENT_NFT=0x4ce1D1E0e9C769221E03e661abBf043cceD84F1f
WALL_REGISTRY=0xE26bAFF16B7c6119A05a3D65cf499DE321F67BAB
WALL_MARKET=0x55D7Af35752065C381Af13a5DcDA86e5Fe3f4045

# ── x402 settlement (ERC-20 on 0G; MockUSDC deployed with the contracts) ──────
PAYMENT_ASSET=0x0d837aD954F4f9F06E303A86150ad0F322Ec5EB1
# Min confirmations before an x402 payment tx is accepted (0 = accept on inclusion)
X402_MIN_CONFIRMATIONS=1

# ── LLM Backend ──────────────────────────────────────────────────────────────
COMPUTE_BACKEND=openai-compat
COMPUTE_BASE_URL=https://openrouter.ai/api/v1
COMPUTE_API_KEY=sk-or-v1-...
COMPUTE_MODEL=google/gemini-2.0-flash-lite-001
# Per-request timeout (ms) — caps a hung upstream model
COMPUTE_TIMEOUT_MS=60000
# Max output tokens per inference
COMPUTE_MAX_TOKENS=1024
# Retries on transient 429/5xx from the LLM backend
COMPUTE_MAX_RETRIES=1

# ── On-chain read cache ───────────────────────────────────────────────────────
# TTL for cached WallRegistry.info() lookups (ms). Unregistered tokens are never
# cached, so newly-registered agents are picked up without a restart.
AGENT_INFO_CACHE_TTL_MS=60000

# ── Server ────────────────────────────────────────────────────────────────────
HTTP_PORT=8402

# ── Persistence ──────────────────────────────────────────────────────────────
AGENTS_DATA_DIR=./data/agents
RECEIPTS_DB_PATH=./data/receipts.db
