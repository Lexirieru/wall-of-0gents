# ── 0G MAINNET operator config (real USDC.e) ──────────────────────────────────
# Copy to .env on the mainnet host (Railway). NEVER commit the filled file.

ZG_RPC_URL=https://evmrpc.0g.ai
ZG_CHAIN_ID=16661

# Mainnet contracts (DeployMainnet.s.sol, chain 16661)
WALL_AGENT_NFT=0x19f1021fF79B7428D4b5618338B02A20aCaD00b9
WALL_MARKET=0x9B9D66405CDcAdbe5d1F300f67A1F89460e4C364
WALL_FRACTIONALIZER=0xe5959e5C96348a2275A93630b34cB37571d6C2E7
WALL_REGISTRY=0xd1Ac9b80A872E8891318A3F6d551055EED399E03

# Real USDC.e on 0G mainnet (6 decimals) — x402 settlement asset
PAYMENT_ASSET=0x1f3AA82227281cA364bFb3d253B0f1af1Da6473E
X402_MIN_CONFIRMATIONS=3

# Keys — operator MUST differ from the contract owner/deployer key.
OPERATOR_PRIVATE_KEY=0x...
RECEIPT_SIGNER_PRIVATE_KEY=0x...

# LLM
COMPUTE_BACKEND=openai-compat
COMPUTE_BASE_URL=https://openrouter.ai/api/v1
COMPUTE_API_KEY=sk-or-v1-...
COMPUTE_MODEL=google/gemini-2.0-flash-lite-001
COMPUTE_TIMEOUT_MS=60000
COMPUTE_MAX_TOKENS=1024
COMPUTE_MAX_RETRIES=1

# ── 0G Compute Network (sealed TeeML inference, wallet-paid) ──────────────────
# Defaults in config.ts are the TESTNET provider — they MUST be repointed for
# mainnet or sealed inference settles on the wrong network. The operator wallet
# (OPERATOR_PRIVATE_KEY) pays the broker, so it needs an A0GI balance.
ZG_COMPUTE_RPC_URL=https://evmrpc.0g.ai
# Verified on-chain via broker.inference.listService() on 0G mainnet (16661):
#   0x4415ef5CBb415347bb18493af7cE01f225Fc0868  qwen/qwen3-vl-30b-a3b-instruct
#   0x1B3AAef3ae5050EEE04ea38cD4B087472BD85EB0  deepseek/deepseek-chat-v3-0324
#   0xd9966e13a6026Fcca4b13E7ff95c94DE268C471C  zai-org/GLM-5-FP8
# Pick one; below is the Qwen3-VL-30B chatbot provider (matches launch wizard).
ZG_COMPUTE_PROVIDER_ADDRESS=0x4415ef5CBb415347bb18493af7cE01f225Fc0868
# REQUIRED before any 0G Compute call: the operator wallet must create a broker
# ledger — minimum deposit is 3 0G (broker.ledger.addLedger(3)). Fund the
# OPERATOR_PRIVATE_KEY wallet with >=3 0G (plus gas) first, or inference 500s.

# ── 0G Storage (iNFT metadata / bundle persistence) ───────────────────────────
# Leave indexer empty to use the local-file fallback. For mainnet durability
# point at the 0G mainnet indexer; key falls back to OPERATOR_PRIVATE_KEY.
ZG_STORAGE_INDEXER_URL=
ZG_STORAGE_PRIVATE_KEY=

# Prod hardening
CORS_ORIGINS=https://your-frontend-domain
TRUST_PROXY=true

# Persistence — MUST be a Railway Volume mount path (not ephemeral FS)
AGENTS_DATA_DIR=/data/agents
RECEIPTS_DB_PATH=/data/receipts.db
