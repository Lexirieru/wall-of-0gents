# Production build-time config. NON-SECRET public values only.
# NEXT_PUBLIC_* is inlined at build time, so this must be present when the
# production bundle is built (committed on purpose — see .gitignore note).
# A dashboard env var of the same name still overrides this at build.

NEXT_PUBLIC_OPERATOR_URL=https://wall-of-0gents-production.up.railway.app
NEXT_PUBLIC_ZG_RPC=https://evmrpc.0g.ai
