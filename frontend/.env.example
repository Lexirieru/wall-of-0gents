# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real values.

# Backend operator URL (Railway production or local dev)
# Production: https://wall-of-0gents-production.up.railway.app
# Local dev:  http://127.0.0.1:8402
NEXT_PUBLIC_OPERATOR_URL=https://your-backend.up.railway.app

# 0G Mainnet RPC endpoint (override if using a private RPC)
# Default: https://evmrpc.0g.ai
NEXT_PUBLIC_ZG_RPC=https://evmrpc.0g.ai
